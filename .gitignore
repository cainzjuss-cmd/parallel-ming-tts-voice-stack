# ---------------------------------------------------------------------------
# Nothing derived from the game's own recordings may ever be published here.
# The stack ships CODE + a URL+size+sha256 manifest for open model weights.
# Voice data (reference audio, its transcript, the chip's persona text) is
# local material the user hand-curated: it stays on their machine.
# ---------------------------------------------------------------------------
*.wav
*.flac
*.mp3
*.ogg
*.m4a
*.fda
*.sga
*.bnk
*.wem

# private rollback snapshot: contains a copy of a patched third-party node file
WINDOWS_SNAPSHOT_*/
WINDOWS_SNAPSHOT_*.zip

# sandbox home from the bit-exact gate (holds a copied reference wav + renders)
testhome/

# node_patch/ is generated by apply_share_hook.py from a pristine upstream clone;
# the patcher ships, the patched third-party copy does not.
node_patch/

# local runtime state
__pycache__/
*.pyc
*.log
.hermes/
.DS_Store

# machine-local config overrides (paths, worker counts) - the template ships as tts_pack.json
config/pack.local.json
!regress_run*.log

# host-local config shim used to make the regression run path-identical on the author's
# machine, and the persona/reference definitions it reads (both are local material)
files/tts_pack.json
files/voice_defs.py
